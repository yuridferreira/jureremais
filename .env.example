# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/jureremais?schema=public"

# ─── Payload CMS ───────────────────────────────────────────────────────────────
PAYLOAD_SECRET="REPLACE_WITH_32_CHAR_RANDOM_STRING"

# ─── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CMS_URL="http://localhost:3001"

# ─── Revalidation ──────────────────────────────────────────────────────────────
REVALIDATE_SECRET="REPLACE_WITH_ANOTHER_32_CHAR_RANDOM_STRING"

# ─── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY="re_REPLACE"
CONTACT_EMAIL="contato@jureremais.org"
FROM_EMAIL="noreply@jureremais.org"

# ─── Storage (S3 / Cloudflare R2) ──────────────────────────────────────────────
S3_BUCKET="jureremais-media"
S3_REGION="sa-east-1"
S3_ACCESS_KEY="REPLACE"
S3_SECRET_KEY="REPLACE"
S3_ENDPOINT="https://REPLACE.r2.cloudflarestorage.com"

# ─── Rate Limiting (Upstash Redis) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://REPLACE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE"

# ─── Analytics ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_REPLACE"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
NEXT_PUBLIC_GA4_ID="G-REPLACE"

# ─── Maps ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN="pk.REPLACE"
